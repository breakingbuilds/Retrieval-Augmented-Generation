# Copy this file to .env and edit the values.  .env is git-ignored; this one is not.
# Every key is optional - config.py has a fallback for each.

# --- identity (shown at the top of Swagger UI) ---------------------------------
APP_NAME=Student Notes API (homework)
APP_VERSION=1.0

# --- GET /notes  ?limit=  rules -------------------------------------------------
DEFAULT_LIMIT=10
MAX_LIMIT=100

# --- RAG ------------------------------------------------------------------------
MAX_SOURCES=3
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Day 3: put the real key in .env only.  NEVER paste a real key into this file.
LLM_API_KEY=
